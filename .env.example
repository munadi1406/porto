# Copy to .env and fill with your keys — never commit .env
# Required for market data & AI

# IDX broker (5 req/day gratis) — https://indexalpha.id
INDEXALPHA_API_KEY=ia_live_xxx

# OpenCode Zen Go — https://opencode.ai/zen  (mimo-v2.5, ox-alpha-free)
OPENCODE_API_KEY=sk-xxx
OPENCODE_MODEL=mimo-v2.5
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# DeepSeek (prospektus) — https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxx

# News enrichment — hemat kredit (cache 30 menit, 1 Serper + max 5 Firecrawl + 1 AI batch per request)
# Serper — https://serper.dev  (1 credit / search)
SERPER_API_KEY=
# Firecrawl — https://firecrawl.dev  (1 credit / scrape)
FIRECRAWL_API_KEY=
# Optional external browser fallback for IDX company detail/ownership
# IDX_FIRECRAWL_FALLBACK=true
# Set to firecrawl to route all IDX API requests through Firecrawl
# IDX_FETCH_PROVIDER=firecrawl

# Database (MySQL) — cPanel/Neon/Railway
DATABASE_URL=mysql://user:pass@host:3306/porto
# or individual:
# DB_HOST=localhost
# DB_USER=porto
# DB_PASS=xxx
# DB_NAME=porto
# DB_PORT=3306
